{
  "name": "arova",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:api\" \"vite\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
